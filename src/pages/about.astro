---
import Layout from "@layouts/Layout.astro";
---

<Layout title="About" description="About software developer Moamen Hredeen.">
    <main class="about-page">
        <header>
            <p class="paper-kicker">Author note</p>
            <h1 class="page-title">About</h1>
        </header>
        <div class="about-copy">
            <p class="lead">
                I’m an enthusiastic software developer, currently living and
                working in Germany. I love tinkering with unusual software ideas
                and diving into difficult technical problems—there’s something
                exciting about breaking things to understand how they work.
            </p>
            <p>
                I was born in 1997 in Tafas, a small town in southern Syria. In
                2015, I left home and moved to Germany as a refugee. Starting over
                meant learning a language, adapting to a new culture, and eventually
                studying computer science. That journey led me to the work I do
                today and to a habit of continuously learning.
            </p>
            <p class="contact-line">
                Correspondence:
                <a href="https://github.com/moamenhredeen">GitHub</a> ·
                <a href="https://linkedin.com/in/moamen-hraden">LinkedIn</a>
            </p>
        </div>
    </main>
</Layout>

<style>
    .about-page {
        max-width: 43rem;
    }

    .about-copy {
        border-top: 1px solid var(--rule-dark);
        padding-top: 1.5rem;
    }

    .about-copy > p:not(.lead) {
        margin-top: 1.5rem;
    }

    .contact-line {
        padding-top: 1rem;
        border-top: 1px solid var(--rule);
        font-size: 0.9rem;
    }
</style>
