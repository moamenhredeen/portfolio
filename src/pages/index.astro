---
import Layout from "@layouts/Layout.astro";
---

<Layout description="The personal portfolio and technical blog of software developer Moamen Hredeen.">
    <main id="main-content" tabindex="-1">
        <p class="paper-kicker">Portfolio · Blog · Technical notes</p>
        <h1 class="page-title">Software, systems,<br />and careful thinking.</h1>
        <p class="lead">
            I’m Moamen Hredeen, a software developer in Germany. This is my
            collection of technical essays, experiments, and working notes on
            software architecture, type systems, and the web.
        </p>

        <nav class="index-links" aria-label="Explore this website">
            <a href="/blog">
                <span class="index-number">01</span>
                <span><strong>Read the blog</strong><small>Technical posts and notes</small></span>
                <span aria-hidden="true">→</span>
            </a>
            <a href="/about">
                <span class="index-number">02</span>
                <span><strong>About the author</strong><small>Background and current work</small></span>
                <span aria-hidden="true">→</span>
            </a>
        </nav>
    </main>
</Layout>

<style>
    main {
        padding: 1rem 0 2rem;
    }

    .index-links {
        margin-top: 4rem;
        border-top: 1px solid var(--rule-dark);
    }

    .index-links a {
        display: grid;
        grid-template-columns: 2.5rem 1fr auto;
        align-items: center;
        gap: 1rem;
        padding: 1.15rem 0;
        border-bottom: 1px solid var(--rule);
        color: var(--ink);
        text-decoration: none;
    }

    .index-links a:hover {
        color: var(--accent);
    }

    .index-number,
    .index-links small {
        color: var(--muted);
        font-size: 0.7rem;
    }

    .index-links strong,
    .index-links small {
        display: block;
    }

    .index-links strong {
        font-weight: 600;
    }
</style>
