---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";

const posts = (await getCollection("posts")).sort(
    (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
);
const dateFormatter = new Intl.DateTimeFormat("en", { dateStyle: "long" });

// Journal-style masthead figures, derived from the archive itself.
const years = posts
    .map((post) => post.data.date?.getFullYear())
    .filter((year): year is number => typeof year === "number");
const establishedYear = years.length ? Math.min(...years) : new Date().getFullYear();
const latestYear = years.length ? Math.max(...years) : establishedYear;
const volume = latestYear - establishedYear + 1;
const issue = posts.length;

const toRoman = (n: number): string => {
    const numerals: [number, string][] = [
        [1000, "M"], [900, "CM"], [500, "D"], [400, "CD"],
        [100, "C"], [90, "XC"], [50, "L"], [40, "XL"],
        [10, "X"], [9, "IX"], [5, "V"], [4, "IV"], [1, "I"],
    ];
    let out = "";
    for (const [value, symbol] of numerals) {
        while (n >= value) {
            out += symbol;
            n -= value;
        }
    }
    return out;
};
---

<Layout title="Blog" description="Technical blog posts and notes by Moamen Hredeen.">
    <main id="main-content" tabindex="-1">
        <header class="masthead">
            <p class="paper-kicker">Collected writings</p>
            <h1 class="page-title">Blog</h1>
            <p class="masthead-tagline">Technical essays, explanations, and working notes.</p>
            <dl class="masthead-meta">
                <div>
                    <dt>Volume</dt>
                    <dd>{toRoman(volume)}</dd>
                </div>
                <div>
                    <dt>Issue</dt>
                    <dd>No.&nbsp;{issue}</dd>
                </div>
                <div>
                    <dt>Established</dt>
                    <dd>{toRoman(establishedYear)}</dd>
                </div>
            </dl>
        </header>

        <ol class="paper-list">
            {posts.map((post, index) => (
                <li>
                    <span class="post-number">{String(index + 1).padStart(2, "0")}</span>
                    <div>
                        <h2><a href={`/blog/${post.id}`}>{post.data.title}</a></h2>
                        {post.data.date && (
                            <time class="post-date" datetime={post.data.date.toISOString().slice(0, 10)}>
                                {dateFormatter.format(post.data.date)}
                            </time>
                        )}
                        <p>{post.data.description}</p>
                        <p class="keywords">{post.data.tags.join(" · ")}</p>
                    </div>
                </li>
            ))}
        </ol>
    </main>
</Layout>

<style>
    .masthead {
        margin-bottom: 2rem;
        text-align: center;
    }

    .masthead .paper-kicker {
        margin-bottom: 0.5rem;
    }

    .masthead .page-title {
        margin: 0;
    }

    .masthead-tagline {
        margin: 0.75rem 0 1.5rem;
        color: var(--muted);
        font-style: italic;
    }

    /* Volume / issue / established line, set between thin rules like a
       journal masthead. Kept to hairlines so it doesn't compete with the
       site header's double rule directly above. */
    .masthead-meta {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 2.5rem;
        margin: 0;
        padding: 0.6rem 0;
        border-top: 1px solid var(--rule);
        border-bottom: 1px solid var(--rule);
    }

    .masthead-meta div {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
    }

    .masthead-meta dt {
        margin: 0;
        color: var(--muted);
        font-size: 0.62rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

    .masthead-meta dd {
        margin: 0;
        font-size: 0.82rem;
        font-variant-numeric: tabular-nums;
        letter-spacing: 0.04em;
    }

    @media (max-width: 700px) {
        .masthead-meta {
            gap: 1.25rem 2rem;
        }
    }

    .paper-list {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .paper-list li {
        display: grid;
        grid-template-columns: 2.5rem 1fr;
        gap: 1rem;
        padding: 1.5rem 0;
        border-bottom: 1px solid var(--rule);
    }

    .paper-list li:last-child {
        border-bottom: 0;
    }

    .post-number {
        padding-top: 0.25rem;
        color: var(--muted);
        font-size: 0.68rem;
    }

    h2 {
        margin: 0 0 0.25rem;
        font-size: 1.35rem;
        font-weight: 600;
        line-height: 1.25;
    }

    .post-date {
        display: block;
        margin-bottom: 0.5rem;
        color: var(--muted);
        font-size: 0.72rem;
        font-variant-numeric: tabular-nums;
        letter-spacing: 0.02em;
    }

    h2 a {
        color: var(--ink);
        text-decoration: none;
    }

    h2 a:hover {
        color: var(--accent);
    }

    .paper-list p {
        max-width: 42rem;
        margin: 0;
        color: var(--muted);
        font-size: 0.95rem;
    }

    .paper-list .keywords {
        margin-top: 0.65rem;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }
</style>
