---
import '../styles/global.css'
import '../styles/JetBrainsMono.css'

interface Props {
    title?: string;
    description?: string;
}

const {
    title,
    description = 'Technical blog posts and notes by Moamen Hredeen.',
} = Astro.props;
const documentTitle = title ? `${title} — Moamen Hredeen` : 'Moamen Hredeen';
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="description" content={description} />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <title>{documentTitle}</title>
    </head>
    <body>
        <div class="paper-page">
            <header class="site-header">
                <div>
                    <p class="paper-kicker">A personal software development blog</p>
                    <a class="site-title" href="/">Moamen Hredeen</a>
                </div>
                <nav class="site-nav" aria-label="Primary navigation">
                    <a href="/blog">Blog</a>
                    <a href="/about">About</a>
                </nav>
            </header>

            <slot />

            <footer class="site-footer">
                <span>Moamen Hredeen</span>
                <span>Software development blog</span>
            </footer>
        </div>
    </body>
</html>

<style>
    @view-transition {
        navigation: auto;
    }
</style>
