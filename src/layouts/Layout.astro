---
import '../styles/global.css'
import '../styles/JetBrainsMono.css'
import '../styles/LatinModern.css'
import 'katex/dist/katex.min.css'

interface Props {
    title?: string;
    description?: string;
}

const {
    title,
    description = 'Technical blog posts and notes by Moamen Hredeen.',
} = Astro.props;
const documentTitle = title ? `${title} — Moamen Hredeen` : 'Moamen Hredeen';
const pathname = Astro.url.pathname;
const isBlog = pathname === '/blog' || pathname.startsWith('/blog/');
const isAbout = pathname === '/about' || pathname.startsWith('/about/');

// Absolute URL for canonical + Open Graph. Astro.site is set in the config;
// fall back to the request origin during dev.
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const ogType = pathname.startsWith('/blog/') && pathname !== '/blog' && pathname !== '/blog/'
    ? 'article'
    : 'website';
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalURL} />
        <link rel="icon" href="/favicon.ico" />
        <link
            rel="alternate"
            type="application/rss+xml"
            title="Moamen Hredeen"
            href={new URL('/rss.xml', Astro.site ?? Astro.url).href}
        />
        <meta name="generator" content={Astro.generator} />
        <title>{documentTitle}</title>

        <!-- Open Graph -->
        <meta property="og:type" content={ogType} />
        <meta property="og:title" content={documentTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:site_name" content="Moamen Hredeen" />
        <meta property="og:locale" content="en_US" />

        <!-- Twitter -->
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={documentTitle} />
        <meta name="twitter:description" content={description} />
    </head>
    <body>
        <a class="skip-link" href="#main-content">Skip to main content</a>
        <div class="paper-page">
            <div class="print-running-header" aria-hidden="true">
                <span>{title ?? 'Moamen Hredeen'}</span>
                <span>{title ? 'Moamen Hredeen' : 'Software development blog'}</span>
            </div>
            <header class="site-header">
                <div>
                    <p class="paper-kicker">A personal software development blog</p>
                    <a class="site-title" href="/" aria-current={pathname === '/' ? "page" : undefined}>Moamen Hredeen</a>
                </div>
                <nav class="site-nav" aria-label="Primary navigation">
                    <a href="/blog" aria-current={isBlog ? "page" : undefined}>Blog</a>
                    <a href="/about" aria-current={isAbout ? "page" : undefined}>About</a>
                    <button class="print-button" type="button" aria-label="Print this page" title="Print this page">
                        <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16">
                            <path d="M6 9V3h12v6M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2M6 14h12v7H6z" />
                        </svg>
                    </button>
                </nav>
            </header>

            <slot />

            <footer class="site-footer">
                <span>Moamen Hredeen</span>
                <span>Software development blog</span>
            </footer>
        </div>
    </body>
</html>

<script>
    document.querySelector<HTMLButtonElement>(".print-button")
        ?.addEventListener("click", () => window.print());
</script>

<style>
    @view-transition {
        navigation: auto;
    }

    @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root),
        ::view-transition-new(root) {
            animation: none;
        }
    }
</style>
