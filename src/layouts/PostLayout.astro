---
import type { MarkdownLayoutProps } from "astro";
import Layout from "./Layout.astro";
import Comments from "@components/vue/Comments.vue";

type Props = MarkdownLayoutProps<{
    title: string;
    description: string;
    tags: string[];
    author?: string;
    date?: string | Date;
    status?: string;
}>;

const { frontmatter } = Astro.props;
const date = frontmatter.date
    ? new Intl.DateTimeFormat("en", { dateStyle: "long" }).format(new Date(frontmatter.date))
    : undefined;
const dateTime = frontmatter.date
    ? new Date(frontmatter.date).toISOString().slice(0, 10)
    : undefined;
---

<Layout
    title={frontmatter.title}
    description={frontmatter.description}
    datePublished={dateTime}
    author={frontmatter.author ?? "Moamen Hredeen"}
>
    <main id="main-content" tabindex="-1">
        <article class="paper-article">
            <header class="article-header">
                {frontmatter.status && <p class="paper-kicker">{frontmatter.status}</p>}
                <h1>{frontmatter.title}</h1>
                <div class="post-meta">
                    <span>{frontmatter.author ?? "Moamen Hredeen"}</span>
                    {date && <time datetime={dateTime}>{date}</time>}
                </div>
                <section class="post-summary" aria-labelledby="abstract-title">
                    <h2 id="abstract-title">Abstract</h2>
                    <p>{frontmatter.description}</p>
                </section>
                <p class="keywords">
                    <strong>Topics:</strong> {frontmatter.tags.join(" · ")}
                </p>
            </header>
            <div class="article-body">
                <slot />
            </div>
            <Comments client:visible slug={Astro.url.pathname} />
        </article>
    </main>
</Layout>

<style>
    .article-header {
        margin: 0 auto 3rem;
        text-align: center;
    }

    .article-header > h1 {
        max-width: 18em;
        margin: 0.35rem auto 1rem;
        font-size: clamp(2.25rem, 6vw, 3.75rem);
        font-weight: 400;
        line-height: 1.08;
        letter-spacing: -0.025em;
    }

    .post-meta {
        display: flex;
        justify-content: center;
        gap: 1.5rem;
        color: var(--muted);
        font-size: 0.76rem;
    }

    .post-summary {
        max-width: 38rem;
        margin: 2.25rem auto 0;
        padding: 1.15rem 1.5rem;
        border-block: 1px solid var(--rule);
        text-align: left;
    }

    .post-summary h2 {
        margin: 0 0 0.35rem;
        font-size: 0.9rem;
        font-family: "Latin Modern Caps";
        letter-spacing: 0.08em;
    }

    .post-summary p {
        margin: 0;
        font-size: 0.96rem;
        line-height: 1.55;
        font-variant-numeric: oldstyle-nums proportional-nums;
    }

    .keywords {
        margin: 0.8rem auto 0;
        color: var(--muted);
        font-size: 0.78rem;
    }

    .article-body {
        max-width: 43rem;
        margin: 0 auto;
        counter-reset: section subsection subsubsection figure listing table;
        /* Oldstyle (text) figures in running prose, so digits sit on the
           baseline with ascenders/descenders like lowercase letters. Tabular
           lining is restored below for tables and for the numbered counters
           (sections, figures, listings, tables). */
        font-variant-numeric: oldstyle-nums proportional-nums;
    }

    /* Number sections like a paper: 1, 1.1, 1.1.1 (headings are demoted,
       so a top-level section renders as h2). */
    .article-body :global(h2) {
        counter-increment: section;
        counter-reset: subsection subsubsection;
    }

    .article-body :global(h3) {
        counter-increment: subsection;
        counter-reset: subsubsection;
    }

    .article-body :global(h4) {
        counter-increment: subsubsection;
    }

    .article-body :global(h2)::before {
        content: counter(section) "\2003";
    }

    .article-body :global(h3)::before {
        content: counter(section) "." counter(subsection) "\2003";
    }

    .article-body :global(h4)::before {
        content: counter(section) "." counter(subsection) "." counter(subsubsection) "\2003";
    }

    .article-body :global(h2)::before,
    .article-body :global(h3)::before,
    .article-body :global(h4)::before {
        color: var(--muted);
        font-weight: 400;
        font-style: normal;
        font-variant-numeric: tabular-nums;
    }

    /* Interactive playgrounds carry their own headings; keep them out of
       the section numbering entirely. */
    .article-body :global(.playground :is(h2, h3, h4)),
    .article-body :global(.demo :is(h2, h3, h4)) {
        counter-increment: none;
    }

    .article-body :global(.playground :is(h2, h3, h4))::before,
    .article-body :global(.demo :is(h2, h3, h4))::before {
        content: none;
    }

    .article-body :global(h1),
    .article-body :global(h2) {
        margin: 2.5rem 0 0.8rem;
        font-size: 1.45rem;
        font-weight: 600;
        line-height: 1.25;
    }

    .article-body :global(h2) {
        font-size: 1.25rem;
    }

    .article-body :global(h3) {
        margin: 2rem 0 0.65rem;
        font-size: 1.05rem;
        font-style: italic;
    }

    .article-body :global(h4),
    .article-body :global(h5),
    .article-body :global(h6) {
        margin: 1.5rem 0 0.5rem;
        font-size: 1rem;
    }

    .article-body :global(p) {
        margin: 0 0 1rem;
        line-height: 1.72;
        text-align: justify;
        hyphens: auto;
        -webkit-hyphens: auto;
    }

    /* Drop cap on the opening paragraph, when the article starts with prose
       rather than a heading. */
    .article-body > :global(p:first-child)::first-letter {
        float: left;
        margin: 0.02em 0.08em 0 0;
        color: var(--accent);
        font-family: "Latin Modern Roman";
        font-size: 3.4em;
        line-height: 0.72;
    }

    /* Small-caps lead-in: the first few words of the opening paragraph, set in
       the true caps face (see rehype-lead-in.mjs). Pairs with the drop cap. */
    .article-body :global(.lead-in) {
        font-family: "Latin Modern Caps";
        letter-spacing: 0.02em;
    }

    .article-body :global(ul),
    .article-body :global(ol) {
        margin: 0.75rem 0 1.25rem;
        padding-left: 1.6rem;
    }

    .article-body :global(li) {
        margin: 0.25rem 0;
    }

    .article-body :global(blockquote) {
        margin: 1.5rem 0;
        padding: 0.1rem 0 0.1rem 1.25rem;
        border-left: 2px solid var(--rule-dark);
        color: var(--muted);
        font-style: italic;
    }

    .article-body :global(pre) {
        overflow-x: auto;
        margin: 1.5rem 0;
        padding: 1rem 1.15rem;
        border: 1px solid var(--code-rule);
        background: var(--code-bg) !important;
        font-size: 0.78rem;
        line-height: 1.55;
    }

    /* Gruvbox's yellow and gray tokens fall below AA on our softer background. */
    .article-body :global(.astro-code span[style*="#B57614"]) {
        color: #8f5f00 !important;
    }

    .article-body :global(.astro-code span[style*="#928374"]) {
        color: #665c54 !important;
    }

    .article-body :global(:not(pre) > code) {
        padding: 0.08em 0.25em;
        background: var(--code-bg);
        font-size: 0.82em;
    }

    .article-body :global(table) {
        width: 100%;
        margin: 1.75rem 0;
        border-collapse: collapse;
        font-size: 0.9rem;
        /* Tabular data reads better with lining figures on a fixed advance. */
        font-variant-numeric: lining-nums tabular-nums;
    }

    .article-body :global(th),
    .article-body :global(td) {
        padding: 0.5rem 0.65rem;
        border-bottom: 1px solid var(--rule);
        text-align: left;
    }

    .article-body :global(th) {
        border-top: 1px solid var(--rule-dark);
        border-bottom-color: var(--rule-dark);
        font-family: "Latin Modern Caps";
    }

    /* Captioned tables become numbered, with the caption above the table
       the way a journal sets them. */
    .article-body :global(figure.table) {
        counter-increment: table;
        margin: 1.75rem 0;
    }

    .article-body :global(figure.table table) {
        margin: 0;
    }

    .article-body :global(figure.table figcaption) {
        margin-bottom: 0.5rem;
        color: var(--muted);
        font-size: 0.82rem;
        line-height: 1.5;
    }

    .article-body :global(figure.table figcaption)::before {
        content: "Table " counter(table) ". ";
        font-weight: 700;
        font-variant-numeric: tabular-nums;
    }

    .article-body :global(img) {
        display: block;
        margin: 2rem auto;
    }

    .article-body :global(figure.figure) {
        counter-increment: figure;
        margin: 2.5rem 0;
        text-align: center;
    }

    .article-body :global(figure.figure img) {
        margin: 0 auto 0.75rem;
    }

    .article-body :global(figure.figure figcaption) {
        margin: 0 auto;
        max-width: 34rem;
        color: var(--muted);
        font-size: 0.85rem;
        line-height: 1.5;
    }

    .article-body :global(figure.figure figcaption)::before {
        content: "Figure " counter(figure) ". ";
        font-weight: 700;
        font-variant-numeric: tabular-nums;
    }

    /* Captioned code blocks become numbered listings. */
    .article-body :global(figure.listing) {
        counter-increment: listing;
        margin: 1.5rem 0;
    }

    .article-body :global(figure.listing pre) {
        margin: 0;
    }

    .article-body :global(figure.listing figcaption) {
        margin-top: 0.5rem;
        color: var(--muted);
        font-size: 0.82rem;
        line-height: 1.5;
    }

    .article-body :global(figure.listing figcaption)::before {
        content: "Listing " counter(listing) ". ";
        font-weight: 700;
        font-variant-numeric: tabular-nums;
    }

    .article-body :global(hr) {
        margin: 2.5rem 0;
        border: 0;
        border-top: 1px solid var(--rule);
    }

    .article-body :global(.markdown-alert) {
        margin: 1.5rem 0;
        padding: 0.75rem 1rem;
        border: 1px solid var(--rule);
        background: transparent;
    }

    .article-body :global(.markdown-alert-title) {
        margin-bottom: 0.25rem;
        font-family: "Latin Modern Caps";
        font-weight: 700;
    }

    /* Footnotes as a numbered "Notes" section at the foot of the article,
       the way a printed paper collects them. */
    .article-body :global(.footnotes) {
        margin-top: 3.5rem;
        padding-top: 1rem;
        border-top: 1px solid var(--rule-dark);
        color: var(--muted);
        font-size: 0.85rem;
    }

    .article-body :global(.footnotes h2) {
        counter-increment: none;
        margin: 0 0 0.75rem;
        color: var(--ink);
        font-size: 0.8rem;
        font-weight: 700;
        font-family: "Latin Modern Caps";
        letter-spacing: 0.08em;
    }

    .article-body :global(.footnotes h2)::before {
        content: none;
    }

    .article-body :global(.footnotes ol) {
        margin: 0;
        padding-left: 1.6rem;
    }

    .article-body :global(.footnotes li) {
        margin: 0.35rem 0;
        line-height: 1.55;
    }

    .article-body :global(.footnotes li)::marker {
        color: var(--muted);
    }

    .article-body :global(.footnotes li p) {
        margin: 0;
    }

    .article-body :global(.footnotes .data-footnote-backref) {
        margin-left: 0.3rem;
        padding: 0;
        border: 0;
        text-decoration: none;
    }

    /* Inline reference marker. */
    .article-body :global([data-footnote-ref]) {
        padding: 0;
        border: 0;
        color: var(--accent);
        font-variant-numeric: tabular-nums;
        text-decoration: none;
    }
</style>
